# Backend API - Environment Variables Example

# Estrutura do Banco de Dados
DATABASE_URL="postgresql://user:password@localhost:5432/investment_db"

POSTGRES_USER="user"
POSTGRES_PASSWORD="password"
POSTGRES_DB="investment_db"

# Autenticação Google OAuth (Painel do Google Cloud)
GOOGLE_CLIENT_ID="seu_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="seu_google_client_secret"

# JWT (gerar secret forte em produção: openssl rand -hex 32)
JWT_SECRET="change-me-in-production"
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=3600
JWT_REFRESH_TOKEN_EXPIRATION_SECONDS=604800

# Integrações Financeiras (APIs Externas)
BRAPI_TOKEN="cole_seu_token_da_brapi_aqui"
BRAPI_BASE_URL="https://brapi.dev/api"
BCB_SGS_BASE_URL="https://api.bcb.gov.br/dados/serie"

# Criptografia para API Keys de exchanges (gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=""

# Paywall Premium — Mercado Pago
# PAYWALL_ENABLED=true  → usuários FREE são redirecionados para /plans (precisam pagar)
# PAYWALL_ENABLED=false → acesso livre, ignora plano do usuário
PAYWALL_ENABLED=true

# Credenciais do Mercado Pago (https://www.mercadopago.com.br/developers/panel/app)
MP_ACCESS_TOKEN="TEST-0000000000000000-000000-00000000000000000000000000000000-000000000"
MP_WEBHOOK_SECRET=""

# Preços dos planos (BRL) — valores default se não definidos
PLAN_PRICE_1M=15.00
PLAN_PRICE_3M=40.00
PLAN_PRICE_6M=72.00
PLAN_PRICE_12M=120.00
