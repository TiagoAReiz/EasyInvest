# Backend API - Environment Variables Example

# Estrutura do Banco de Dados
DATABASE_URL="postgresql://user:password@localhost:5432/investment_db"

POSTGRES_USER="user"
POSTGRES_PASSWORD="password"
POSTGRES_DB="investment_db"

# Integrações Financeiras (APIs Externas)
# Crie uma conta gratuita em brapi.dev e coloque o Token aqui
BRAPI_TOKEN="cole_seu_token_da_brapi_aqui"

# Autenticação Google OAuth (Painel do Google Cloud)
GOOGLE_CLIENT_ID="seu_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="seu_google_client_secret"
